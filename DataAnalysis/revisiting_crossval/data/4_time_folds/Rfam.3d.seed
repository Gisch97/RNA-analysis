#=GF DR   SO; 0000391; U1_snRNA;
#=GF DR   GO; 0000395; mRNA 5'-splice site recognition;
#=GF DR   GO; 0030627; pre-mRNA 5'-splice site binding;
#=GF DR   GO; 0005685; U1 snRNP;
#=GF RN   [1]
#=GF RM   9016512
